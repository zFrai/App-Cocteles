rules_version = '2';

// Reglas de seguridad de BarCraft (v3).
// Pégalas en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    // Formato del tag: nombre (letras con tildes, números y _ - . / \ |, máx. 16) + 4 cifras.
    // Debe coincidir con UserRepository.tagBase.
    function tagFormatOk(t) {
      return t is string && t.matches('^[\\p{L}0-9_.|/\\\\-]{1,16}[0-9]{4}$');
    }
    // Id del documento en tags/: Firestore no admite "/" (ver UserRepository.tagKey).
    function tagKey(t) { return t.replace('/', '%2F'); }
    function active() { return signedIn() && me().banned != true; }
    // Debe coincidir con Permissions.canPublishPosts en model/Role.kt
    function canPublish() { return active() && me().role in ['barman', 'admin']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── Seguimientos (ver FriendsRepository) ─────────────────────
    function isPrivate(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('privateAccount', false) == true;
    }
    // a sigue a b (aceptado).
    function follows(a, b) {
      return exists(/databases/$(database)/documents/follows/$(a + '_' + b))
             && get(/databases/$(database)/documents/follows/$(a + '_' + b)).data.status == 'accepted';
    }
    // Amistad aceptada del sistema anterior (para convertirla en seguimiento aunque la cuenta sea privada).
    function wereFriends(a, b) {
      let pair = a < b ? a + '_' + b : b + '_' + a;
      return exists(/databases/$(database)/documents/friendships/$(pair))
             && get(/databases/$(database)/documents/friendships/$(pair)).data.status == 'accepted';
    }
    // b ha bloqueado a a.
    function blockedBy(a, b) {
      return exists(/databases/$(database)/documents/users/$(b)/private/settings)
             && a in get(/databases/$(database)/documents/users/$(b)/private/settings).data.get('blocked', []);
    }
    // Se puede chatear si la cuenta del otro es pública o si os seguís los dos (ver Person.canChat).
    function canChatWith(other) {
      return !isPrivate(other) || (follows(request.auth.uid, other) && follows(other, request.auth.uid));
    }

    // ── Usuarios ───────────────────────────────────────────────
    match /users/{uid} {
      // El @tag solo se pone una vez y tiene que estar reservado a mi nombre en tags/{tag}
      // en la misma transacción (ver UserRepository.ensureTag).
      function tagOk() {
        return !('tag' in changed())
               || (resource.data.get('tag', '') == ''
                   && tagFormatOk(request.resource.data.tag)
                   && getAfter(/databases/$(database)/documents/tags/$(tagKey(request.resource.data.tag))).data.uid == uid);
      }

      function photoOk(p) {
        return p is string
               && (p == '' || (p.size() <= 64
                               && exists(/databases/$(database)/documents/media/$(p))
                               && get(/databases/$(database)/documents/media/$(p)).data.ownerId == uid));
      }

      // Descripción de 250 caracteres como máximo y "Dónde encontrarme" como mapa de textos cortos.
      function profileFieldsOk() {
        return request.resource.data.get('bio', '').size() <= 250
               && (!('links' in request.resource.data)
                   || (request.resource.data.links is map && request.resource.data.links.size() <= 6))
               && request.resource.data.get('privateAccount', false) is bool
               // Foto de perfil: vacía o un archivo propio de media/ (ver UserRepository.setPhoto).
               && (!('photoId' in changed()) || photoOk(request.resource.data.get('photoId', '')))
               // El email ya no vive aquí (cualquiera podría leerlo): solo se permite borrarlo.
               && (!('email' in changed()) || !('email' in request.resource.data));
      }

      allow read: if signedIn();
      // Al registrarse cada uno crea SU documento como Barman o Comensal (nunca Admin).
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['barman', 'cliente']
                    && request.resource.data.banned == false
                    && !('tag' in request.resource.data)
                    && !('email' in request.resource.data);
      // Cada uno edita su nombre y bio, pero no su rol ni su bloqueo.
      // También su descripción, "Dónde encontrarme", si la cuenta es privada y su foto de perfil.
      allow update: if (signedIn() && request.auth.uid == uid && !changed().hasAny(['role', 'banned']) && tagOk()
                        && profileFieldsOk())
                    // Un Admin cambia roles y bloqueos de otros.
                    || (isAdmin() && request.auth.uid != uid
                        && changed().hasOnly(['role', 'banned'])
                        && request.resource.data.role in ['barman', 'cliente', 'admin']);
      allow delete: if false;

      // Favoritos y bloqueados: privados, solo su dueño.
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Publicaciones guardadas: privadas, solo su dueño.
      match /saved/{postId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Recetas compartidas (ver RecipeShareRepository). Las privadas no se suben.
      match /recipes/{recipeId} {
        allow read: if signedIn()
                    && (request.auth.uid == uid
                        || resource.data.visibility == 'public'
                        || (resource.data.visibility == 'followers' && follows(request.auth.uid, uid)));
        allow create, update: if active() && request.auth.uid == uid
                              && request.resource.data.authorId == uid
                              && request.resource.data.visibility in ['followers', 'public']
                              && request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 100
                              && request.resource.data.ingredients.size() <= 40
                              && request.resource.data.steps.size() <= 40;
        // Su autor, o un Admin para moderar.
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ── @tags (identificador único de cada usuario) ────────────
    // tags/{tag} = { uid }. El id del documento es el tag, así que no puede haber dos iguales.
    // Comunidad: consulta de grupo con todas las recetas públicas.
    match /{path=**}/recipes/{recipeId} {
      allow read: if signedIn() && resource.data.visibility == 'public';
    }

    // ── Emails (fuera del perfil público) ──────────────────────────
    match /emails/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['email'])
                            && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /tags/{tag} {
      allow read: if signedIn();
      // Solo se reserva junto con el perfil (misma transacción) y con formato válido.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && tagKey(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.tag) == tag;
      allow update, delete: if false;
    }

    // ── Amistades ──────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if signedIn()
                  && request.auth.uid in [resource.data.followerId, resource.data.followedId];
      // Solo sigo yo; a una cuenta privada se le envía solicitud ("pending"), salvo amistad antigua aceptada.
      allow create: if active()
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.followedId != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.followedId
                    && request.resource.data.keys().hasOnly(['followerId', 'followedId', 'status', 'createdAt', 'fromFriendship'])
                    && !blockedBy(request.auth.uid, request.resource.data.followedId)
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'accepted'
                            && (!isPrivate(request.resource.data.followedId)
                                || wereFriends(request.auth.uid, request.resource.data.followedId))));
      // Solo la cuenta seguida acepta la solicitud.
      allow update: if active() && request.auth.uid == resource.data.followedId
                    && changed().hasOnly(['status'])
                    && request.resource.data.status == 'accepted';
      // Dejar de seguir, cancelar, rechazar o quitar seguidor: cualquiera de los dos.
      allow delete: if signedIn()
                    && request.auth.uid in [resource.data.followerId, resource.data.followedId];
    }

    // Sistema anterior: ya no se crean amistades nuevas; solo se leen para convertirlas en seguimientos.
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create, update: if false;
      // Cualquiera de los dos puede cancelar, rechazar o romper la amistad.
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ── Chats privados ─────────────────────────────────────────
    match /chats/{roomId} {
      function room() { return get(/databases/$(database)/documents/chats/$(roomId)).data; }

      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // Conversación nueva: solo si su cuenta es pública o si os seguís los dos.
      allow create: if active() && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && canChatWith(request.resource.data.participants[0] == request.auth.uid
                                   ? request.resource.data.participants[1]
                                   : request.resource.data.participants[0]);
      allow update: if signedIn() && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function inRoom() { return request.auth.uid in room().participants; }
        function notBlocked() { return room().get('blockedBy', []).size() == 0; }

        allow read: if signedIn() && inRoom();
        allow create: if active() && inRoom() && notBlocked()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.type in ['text', 'image', 'audio', 'gif', 'sticker']
                      && request.resource.data.text.size() <= 2000;
        // Reacciones: cada uno solo puede tocar la suya.
        allow update: if active() && inRoom()
                      && changed().hasOnly(['reactions'])
                      && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Fotos y notas de voz ───────────────────────────────────
    match /media/{mediaId} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.data.size() <= 1000000;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ── Denuncias ──────────────────────────────────────────────
    // Se denuncia desde un chat: quien denuncia y el denunciado deben ser los dos participantes.
    // Solo el Admin las lee y las cierra (pestaña "Denuncias" de su panel).
    match /reports/{reportId} {
      function chatOf(roomId) { return get(/databases/$(database)/documents/chats/$(roomId)).data; }

      allow create: if active()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedId != request.auth.uid
                    && request.auth.uid in chatOf(request.resource.data.roomId).participants
                    && request.resource.data.reportedId in chatOf(request.resource.data.roomId).participants
                    && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'impersonation', 'other']
                    && request.resource.data.status == 'open'
                    && request.resource.data.details.size() <= 500
                    && request.resource.data.messageText.size() <= 2000;
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && changed().hasOnly(['status', 'resolvedBy', 'resolvedAt'])
                    && request.resource.data.status in ['resolved', 'dismissed']
                    && request.resource.data.resolvedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Comunidad (red social) ─────────────────────────────────
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if canPublish() && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.likes.size() == 0
                    && request.resource.data.commentCount == 0;
      // Cualquiera activo puede dar "me gusta" o sumar comentarios; el autor solo puede editar el texto
      // (y editedAt, que avisa a quien la tenga guardada).
      allow update: if active() && (changed().hasOnly(['likes', 'commentCount'])
                                    || (resource.data.authorId == request.auth.uid
                                        && changed().hasOnly(['text', 'editedAt', 'likes', 'commentCount'])
                                        && request.resource.data.text.size() <= 2000));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if active() && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if false;
      }
    }
  }
}
